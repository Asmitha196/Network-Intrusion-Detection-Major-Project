# =============================================================================
# .env.example — Native Local Development Environment Configuration
# Copy this file to .env:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL / TimescaleDB (Running locally on localhost:5432)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Akrithi@1234
POSTGRES_DB=NIDS

# Async SQLAlchemy URL used by the FastAPI backend and background worker.
DATABASE_URL=postgresql+asyncpg://postgres:Akrithi%401234@localhost:5432/NIDS

# -----------------------------------------------------------------------------
# Redis (Running locally on localhost:6379)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Ingestion Mode
# -----------------------------------------------------------------------------
# replay  — replay a .pcap file (default)
# live    — capture live packets from network interface
CAPTURE_MODE=replay

# Path to the .pcap file used in replay mode
PCAP_PATH=data/sample.pcap

# Speed multiplier for pcap replay (1.0 = real time, 0 = maximum speed)
PCAP_REPLAY_SPEED=1.0

# -----------------------------------------------------------------------------
# ML Model Artifacts
# -----------------------------------------------------------------------------
MODEL_ARTIFACTS_DIR=ml/artifacts
CLASSIFIER_MODEL_PATH=ml/artifacts/classifier.pkl
AUTOENCODER_MODEL_PATH=ml/artifacts/autoencoder.pt
SCALER_PATH=ml/artifacts/scaler.pkl
AUTOENCODER_THRESHOLD=0.05298595
STAGE1_CONFIDENCE_THRESHOLD=0.70

# -----------------------------------------------------------------------------
# Security & JWT Auth
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=ids-enterprise-soc-secret-key-2026
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
